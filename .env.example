# Copy to .env.local and fill in. .env.local is never committed (see .gitignore).
# Add the same values in Vercel → Project → Settings → Environment Variables.

# Live weather for Jamshedpur (src/lib/weather.ts). Free key from https://www.weatherapi.com
WEATHER_API_KEY=

# The visitors' brick wall (src/lib/db.ts). Free Redis database from https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
