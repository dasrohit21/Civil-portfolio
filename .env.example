# Copy to .env.local and fill in. .env.local is never committed (see .gitignore).
# Add the same values in Vercel → Project → Settings → Environment Variables.

# Live weather for Jamshedpur (src/lib/weather.ts). Free key from https://www.weatherapi.com
WEATHER_API_KEY=

# ── Neon: `neon deploy` (or `neon env pull`) writes everything in this block ──
# Postgres: the wall and the photo list (src/lib/db.ts). Pooled for the app, unpooled for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Studio sign-in (src/lib/auth.ts)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# The live wall (src/lib/realtime.ts)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Site photos in the `assets` bucket (src/lib/storage.ts)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# The sample Neon Function
NEON_FUNCTION_HELLO_BASE_URL=

# Signs the studio's session cookie. Not from Neon: make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
